{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd panel && npm ci",
  "buildCommand": "cd panel && npm run build",
  "outputDirectory": "panel/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "{backend/*.py,motor/*.py,contrato/validador.py,contrato/esquemas/**,contrato/fixtures/**,datos/procesados/*.csv,datos/procesados/red/*.csv}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" }
  ]
}
