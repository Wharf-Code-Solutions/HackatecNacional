{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix panel && npm ci --prefix ciudadano",
  "buildCommand": "VITE_API_URL=/api npm run build --prefix panel && VITE_API_URL=/api npm run build --prefix ciudadano && node panel/scripts/ensamblar-sitio.mjs",
  "outputDirectory": "panel/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "{backend/*.py,motor/*.py,contrato/*.py,contrato/esquemas/**,contrato/fixtures/**,datos/procesados/*.csv,datos/procesados/red/*.csv,datos/procesados/red/red_asignacion.json,datos/procesados/mapa/red_hidrografica.geojson}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" }
  ]
}
